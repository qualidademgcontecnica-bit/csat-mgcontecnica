<script src="https://cdn.tailwindcss.com"></script>

<style>

/* BODY */

body{

margin:0;
font-family:Arial,sans-serif;
background:#070b1a;
overflow-x:hidden;
color:white;

}

/* FUNDO */

.background{

position:fixed;
inset:0;

background:
linear-gradient(rgba(7,11,26,0.96), rgba(7,11,26,0.96)),
url('logo.png');

background-repeat:no-repeat;
background-position:center;
background-size:30%;

opacity:0.12;

z-index:-5;

}

/* ESTRELAS */

.background::before{

content:"✨ ✦ ⭐ ✨ ✦ ⭐ ✨";

position:absolute;
inset:0;

display:flex;

justify-content:space-around;
align-items:center;

font-size:55px;

letter-spacing:220px;

opacity:0.15;

color:#f5d76e;

animation:stars 10s ease-in-out infinite;

filter:
drop-shadow(0 0 10px #f5d76e);

}

@keyframes stars{

0%{
transform:translateY(0px);
}

50%{
transform:translateY(-15px);
}

100%{
transform:translateY(0px);
}

}

/* FOGUETE */

.rocket{

position:fixed;

left:-150px;
bottom:-100px;

font-size:90px;

opacity:0.12;

z-index:-1;

animation:rocketFly 12s linear infinite;

filter:
drop-shadow(0 0 25px #ff003c);

}

@keyframes rocketFly{

0%{

left:-150px;
bottom:-100px;

transform:
rotate(25deg)
scale(0.8);

}

50%{

transform:
rotate(15deg)
scale(1);

}

100%{

left:110%;
bottom:120%;

transform:
rotate(8deg)
scale(1.2);

}

}

/* CONTAINER */

.container{

width:95%;
max-width:1600px;

margin:auto;

padding-top:50px;
padding-bottom:80px;

}

/* HEADER */

.header{

text-align:center;
margin-bottom:60px;

}

/* LOGO */

.logo{

width:180px;

display:block;

margin:auto;

margin-bottom:25px;

}

/* TITULO */

h1{

font-size:68px;

margin-bottom:10px;

}

/* SUB */

.sub{

font-size:24px;

color:#cbd5e1;

}

/* DASHBOARD */

.dashboard{

display:grid;

grid-template-columns:
repeat(4,1fr);

gap:25px;

margin-top:50px;
margin-bottom:70px;

}

/* STATS */

.stat{

background:
rgba(255,255,255,0.05);

border:
1px solid rgba(255,255,255,0.1);

border-radius:30px;

padding:35px;

text-align:center;

backdrop-filter:blur(8px);

box-shadow:
0 20px 40px rgba(0,0,0,0.4);

transition:0.4s;

}

.stat:hover{

transform:
translateY(-8px)
scale(1.02);

border:
1px solid rgba(255,0,60,0.4);

}

/* TITULO STAT */

.stat-title{

font-size:22px;

color:#cbd5e1;

margin-bottom:15px;

}

/* NUMERO */

.stat-number{

font-size:55px;

font-weight:bold;

color:#ff003c;

}

/* CARDS */

.cards{

display:grid;

grid-template-columns:
repeat(5,1fr);

gap:25px;

align-items:stretch;

}

/* RESPONSIVO */

@media(max-width:1400px){

.cards{

grid-template-columns:
repeat(3,1fr);

}

}

@media(max-width:900px){

.cards{

grid-template-columns:
repeat(2,1fr);

}

}

@media(max-width:700px){

.cards{

grid-template-columns:
1fr;

}

.dashboard{

grid-template-columns:
1fr;

}

}

/* CARD */

.card{

display:flex;

flex-direction:column;

min-height:560px;

background:
rgba(255,255,255,0.05);

border:
1px solid rgba(255,255,255,0.1);

border-radius:35px;

padding:40px;

text-align:center;

backdrop-filter:blur(10px);

box-shadow:
0 20px 50px rgba(0,0,0,0.45);

transition:0.5s;

position:relative;

overflow:hidden;

}

/* HOVER */

.card:hover{

transform:
translateY(-10px)
scale(1.02);

border:
1px solid rgba(255,0,60,0.4);

box-shadow:
0 0 35px rgba(255,0,60,0.25);

}

/* BRILHO */

.card::before{

content:"";

position:absolute;

top:-120%;
left:-40%;

width:80%;
height:300%;

background:
linear-gradient(
to right,
transparent,
rgba(255,255,255,0.12),
transparent
);

transform:rotate(25deg);

transition:0.8s;

}

.card:hover::before{

left:140%;

}

/* ICON */

.icon{

font-size:65px;

margin-bottom:25px;

}

/* TITULO CARD */

.card-title{

font-size:30px;

font-weight:bold;

margin-bottom:15px;

}

/* TEXTO */

.card-text{

font-size:18px;

line-height:1.6;

color:#cbd5e1;

margin-bottom:25px;

}

/* BOTÃO */

.btn{

display:inline-block;

padding:16px 28px;

border-radius:18px;

background:#ff003c;

color:white;

font-weight:bold;

border:none;

cursor:pointer;

transition:0.3s;

margin-top:auto;

}

.btn:hover{

transform:scale(1.05);

}

/* PREVIEW */

.preview{

max-height:0;

overflow:hidden;

opacity:0;

transition:0.6s;

margin-top:0;

width:100%;

}

/* CARD ABERTO */

.card.aberto .preview{

max-height:1000px;

opacity:1;

margin-top:30px;

}

/* STATS RESUMO */

.preview-stat{

background:
rgba(255,255,255,0.05);

padding:16px;

border-radius:18px;

margin-bottom:15px;

font-size:18px;

border:
1px solid rgba(255,255,255,0.05);

}

/* RANKING */

.ranking{

margin-top:30px;

padding-top:25px;

border-top:
1px solid rgba(255,255,255,0.08);

}

.ranking h3{

font-size:24px;

margin-bottom:20px;

}

/* ITENS RANKING */

.rank-item{

background:
rgba(255,255,255,0.04);

padding:14px;

border-radius:15px;

margin-bottom:12px;

font-size:17px;

transition:0.3s;

}

.rank-item:hover{

transform:translateX(5px);

background:
rgba(255,0,60,0.12);

}

/* BOTÃO ABERTO */

.card.aberto .btn{

background:#22c55e;

}

/* FOOTER */

.footer{

margin-top:80px;

text-align:center;

color:#94a3b8;

font-size:18px;

}

</style>

</head>

