<script>

/* ABRIR RESUMO */

function abrirResumo(botao){

const card =
botao.closest(".card");

document
.querySelectorAll(".card")
.forEach(c => {

if(c !== card){

c.classList.remove("aberto");

const b =
c.querySelector(".btn");

b.innerText = "ACESSAR";

}

});

card.classList.toggle("aberto");

if(card.classList.contains("aberto")){

botao.innerText =
"RESUMO ABERTO";

}else{

botao.innerText =
"ACESSAR";

}

}

/* GOOGLE SHEETS */

const URL_CSV =
"https://docs.google.com/spreadsheets/d/e/2PACX-1vQ6bbUeI3nUwD1BK29D9QbTenbIocGWkDgaGkC6RHnt6Ham0aBMTvYIGO9Et97k8P-GgOn4ZNuec3tz/pub?output=csv";

async function carregarDados(){

const resposta =
await fetch(URL_CSV);

const texto =
await resposta.text();

const linhas =
texto.trim().split("\n").slice(1);

let totalCSAT = 0;

let totalAvaliacoes = 0;

const setores = {};

linhas.forEach(linha => {

const colunas =
linha.split(",");

const coordenador =
colunas[2]?.trim();

const setor =
colunas[3]?.trim();

const csat =
parseFloat(colunas[9]);

if(!setor || isNaN(csat))
return;

totalCSAT += csat;

totalAvaliacoes++;

if(!setores[setor]){

setores[setor] = {

total:0,
quantidade:0,
coords:{}

};

}

setores[setor].total += csat;

setores[setor].quantidade++;

if(!setores[setor].coords[coordenador]){

setores[setor].coords[coordenador] = {

total:0,
quantidade:0

};

}

setores[setor]
.coords[coordenador]
.total += csat;

setores[setor]
.coords[coordenador]
.quantidade++;

});

/* DASHBOARD */

const media =
(totalCSAT / totalAvaliacoes)
.toFixed(1);

const satisfacao =
(media * 10).toFixed(0);

let melhorSetor = "-";
let melhorMedia = 0;

Object.keys(setores)
.forEach(setor => {

const mediaSetor =
setores[setor].total /
setores[setor].quantidade;

if(mediaSetor > melhorMedia){

melhorMedia = mediaSetor;
melhorSetor = setor;

}

});

document.getElementById(
"mediaGeral"
).innerText = media;

document.getElementById(
"totalAvaliacoes"
).innerText = totalAvaliacoes;

document.getElementById(
"melhorSetor"
).innerText = melhorSetor;

document.getElementById(
"satisfacaoGeral"
).innerText =
satisfacao + "%";

/* MAPEAMENTO */

const mapa = {

"Contábil Indústria":"ci",
"Contabil Industria":"ci",

"Contábil Varejo":"cv",
"Contabil Varejo":"cv",

"Departamento Pessoal":"dp",
"DP":"dp",

"Fiscal Indústria":"fi",
"Fiscal Industria":"fi",
"EF Indústria":"fi",

"Fiscal Varejo":"fv",
"EF Varejo":"fv"


};

/* CARDS */

Object.keys(setores)
.forEach(setor => {

const prefixo =
mapa[setor];

if(!prefixo)
return;

const mediaSetor =
(
setores[setor].total /
setores[setor].quantidade
).toFixed(1);

const quantidade =
setores[setor].quantidade;

const satisfacaoSetor =
(mediaSetor * 10)
.toFixed(0);

/* INSERIR */

document.getElementById(
`${prefixo}-csat`
).innerHTML =
`⭐ Média CSAT: ${mediaSetor}`;

document.getElementById(
`${prefixo}-avaliacoes`
).innerHTML =
`📋 ${quantidade} avaliações`;

document.getElementById(
`${prefixo}-satisfacao`
).innerHTML =
`🔥 ${satisfacaoSetor}% satisfação`;

/* TOP 3 */

const ranking = [];

Object.keys(setores[setor].coords)
.forEach(coord => {

const dadosCoord =
setores[setor].coords[coord];

const mediaCoord =
dadosCoord.total /
dadosCoord.quantidade;

ranking.push({

nome: coord,
media: mediaCoord

});

});

ranking.sort((a,b)=>
b.media - a.media
);

const top3 =
ranking.slice(0,3);

const medals = [
"🥇",
"🥈",
"🥉"
];

let html = "";

top3.forEach((item,index)=>{

html += `

<div class="rank-item">

${medals[index]}
${item.nome}
— ${item.media.toFixed(1)}

</div>

`;

});

document.getElementById(
`ranking-${prefixo}`
).innerHTML = html;

});

}

carregarDados();

</script>

